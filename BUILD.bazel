load(
    "//:kotlin.bzl",
    "setup_jpa_allopen_plugin",
    "setup_jpa_noarg_plugin",
    "setup_kotlin_compiler",
    "setup_spring_allopen_plugin",
)

package(default_visibility = ["//visibility:public"])

setup_kotlin_compiler()

setup_spring_allopen_plugin(target_name = "spring_allopen")

setup_jpa_allopen_plugin(target_name = "spring_allopen")

setup_jpa_noarg_plugin()

# 실행 가능한 서비스는 platform 하나다. 모듈(identity, application, ...)은 platform 에 조립되는 라이브러리다.
alias(
    name = "platform",
    actual = "//systems/platform/platform-bootstrap:main",
)

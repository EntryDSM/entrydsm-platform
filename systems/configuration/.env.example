# Spring profile: dev or prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8086
SWAGGER_ENABLED=true

# Database
DB_USERNAME=root
DB_PASSWORD=change-me
DB_URL=jdbc:mysql://localhost:3306/configuration_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_MAX_POOL_SIZE=3
DB_MIN_IDLE=1

# S3
AWS_S3_BUCKET=entrydsm-document-local
AWS_S3_REGION=ap-northeast-2
AWS_S3_PRESIGN_EXPIRY_SECONDS=600
STORAGE_ENV=stag

# gRPC
GRPC_PORT=9090

# application gRPC (수험표에 찍을 지원자 정보)
APPLICATION_GRPC_HOST=localhost
APPLICATION_GRPC_PORT=9090
APPLICATION_GRPC_DEADLINE_MS=3000

# 수험표 제목의 입학 학년도
ADMISSION_YEAR=2027

LOGGING_LEVEL_ROOT=INFO

# Spring profile: dev or prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8086
SWAGGER_ENABLED=true

# Database
DB_USERNAME=root
DB_PASSWORD=change-me
DB_URL=jdbc:mysql://localhost:3306/configuration_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_MAX_POOL_SIZE=3
DB_MIN_IDLE=1

# S3
AWS_S3_REGION=ap-northeast-2
AWS_S3_PRESIGN_EXPIRY_SECONDS=600
STORAGE_ENV=stag
# Application과 같은 버킷으로 설정한다.
STORAGE_BUCKET=entrydsm-admin
# 내부 RPC의 허용 버킷. 생략하면 STORAGE_BUCKET을 사용한다.
AWS_S3_INTERNAL_BUCKETS=entrydsm-admin

# gRPC
GRPC_PORT=9090

LOGGING_LEVEL_ROOT=INFO

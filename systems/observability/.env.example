# Server
# Gateway 의 GATEWAY_SERVICES_OBSERVABILITY 가 가리키는 포트와 같아야 한다.
SERVER_PORT=8085

# Redis
# 세션·지표·로그·리포트와 실시간 로그(Pub/Sub)가 모두 여기에 있다. 인스턴스가 여러 대면 모두 같은 Redis 를 봐야 한다.
# docker compose 의 redis 컨테이너는 호스트마다 따로 뜨므로, 여러 호스트에 배포할 때는 공용 Redis 를 가리킨다.
REDIS_HOST=localhost
REDIS_PORT=6379
# 비밀번호나 TLS 가 필요한 Redis 라면 Spring 표준 환경변수로 준다.
# SPRING_DATA_REDIS_PASSWORD=
# SPRING_DATA_REDIS_SSL_ENABLED=true

# 헬스체크 대상. 논리 서비스마다 실제로 처리하는 서비스 주소를 준다(배포에서는 Gateway 의 GATEWAY_SERVICES_* 와 같은 값).
# IDENTITY·AUTH → identity, APPLICATION·EVALUATION → application,
# DOCUMENT·SCHEDULE → configuration, NOTIFICATION → notification
IDENTITY_BASE_URL=http://localhost:8081
AUTH_BASE_URL=http://localhost:8081
APPLICATION_BASE_URL=http://localhost:8082
EVALUATION_BASE_URL=http://localhost:8082
DOCUMENT_BASE_URL=http://localhost:8086
SCHEDULE_BASE_URL=http://localhost:8086
NOTIFICATION_BASE_URL=http://localhost:8084

# 대시보드와 리포트에 표시할 모집 회차
MONITOR_ROUND_NAME=2027
MONITOR_ROUND_FROM=2026-09-01T00:00:00+09:00
MONITOR_ROUND_TO=2026-11-01T00:00:00+09:00

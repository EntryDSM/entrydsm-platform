# Spring profile: dev or prod
SPRING_PROFILES_ACTIVE=dev

# Server
SERVER_PORT=8080
SWAGGER_ENABLED=true

# Database
DB_USERNAME=root
DB_PASSWORD=change-me
DB_URL=jdbc:mysql://localhost:3306/application_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_MAX_POOL_SIZE=3
DB_MIN_IDLE=1

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
REDIS_CLIENT_NAME=application

# Application schedule (GET /applicants/landing 응답에만 싣는다)
# 원서를 받을지는 이 값이 아니라 Application DB의 "원서 접수" 일정으로 정한다.
# Format: yyyy-MM-ddTHH:mm:ss
APPLICATION_START_AT=2026-09-01T00:00:00
APPLICATION_END_AT=2026-10-01T00:00:00
RESULT_ANNOUNCED_AT=2026-11-01T00:00:00

# gRPC
GRPC_PORT=9090

# Configuration gRPC (범용 파일 저장). configuration 의 GRPC_PORT 와 같아야 한다.
# 미설정 시 docker compose 기준 configuration:9090 으로 붙는다.
CONFIGURATION_GRPC_HOST=localhost
CONFIGURATION_GRPC_PORT=9090
CONFIGURATION_GRPC_DEADLINE_MS=10000

LOGGING_LEVEL_ROOT=INFO

# Base64-encoded 128/192/256-bit AES key for applicant personal data
APPLICATION_PII_ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# 원서 상태 이벤트용 스냅샷 키. 원본 개인정보 키와 다른 키를 사용한다.
APPLICATION_SNAPSHOT_KEY_ID=dev
APPLICATION_SNAPSHOT_KEY_BASE64=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=

# 이전 검증 후 단일 전환 배포에서만 true로 변경한다.
APPLICATION_ADMINISTRATION_ENABLED=false
FIRST_PASS_MULTIPLIER=1.5
STORAGE_BUCKET=entrydsm-admin
STORAGE_ENV=stag
DOWNLOAD_URL_EXPIRES_SECONDS=900
AWS_S3_BUCKET=entrydsm-document-local
AWS_S3_PRESIGN_EXPIRY_SECONDS=600
ADMISSION_YEAR=2027
KAKAO_REST_API_KEY=change-me
KAKAO_GEOCODING_URL=https://dapi.kakao.com/v2/local/search/keyword.json
KAKAO_DIRECTIONS_URL=https://apis-navi.kakaomobility.com/v1/directions
KAKAO_API_TIMEOUT_MS=3000
SCHOOL_ADDRESS=대덕소프트웨어마이스터고등학교

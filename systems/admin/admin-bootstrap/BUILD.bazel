load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_binary", "kt_jvm_test")
load(":deps.bzl", "MODULE_DEPS", "TEST_DEPS")

package(default_visibility = ["//visibility:public"])

kt_jvm_binary(
    name = "main",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    javac_opts = "//:javac_options",
    kotlinc_opts = "//:kotlinc_options",
    main_class = "hs.kr.entrydsm.admin.AdminBootstrapApplicationKt",
    plugins = ["//:spring_allopen"],
    resources = glob(["src/main/resources/**"]),
    deps = MODULE_DEPS + [
        "//systems/admin/admin-adapter-in:main",
        "//systems/admin/admin-adapter-out:main",
        "//systems/admin/admin-application:main",
        "//systems/admin/admin-domain:main",
    ],
)

kt_jvm_test(
    name = "test",
    srcs = glob(["src/test/kotlin/**/*.kt"]) + [
        "src/main/kotlin/hs/kr/entrydsm/admin/config/SnapshotCipherConfiguration.kt",
    ],
    javac_opts = "//:javac_options",
    kotlinc_opts = "//:kotlinc_options",
    plugins = ["//:spring_allopen"],
    test_class = "hs.kr.entrydsm.admin.AdminBootstrapApplicationTest",
    deps = MODULE_DEPS + TEST_DEPS,
)

kt_jvm_test(
    name = "snapshot_cipher_configuration_test",
    srcs = [
        "src/main/kotlin/hs/kr/entrydsm/admin/config/SnapshotCipherConfiguration.kt",
        "src/test/kotlin/hs/kr/entrydsm/admin/config/SnapshotCipherConfigurationTest.kt",
    ],
    javac_opts = "//:javac_options",
    kotlinc_opts = "//:kotlinc_options",
    test_class = "hs.kr.entrydsm.admin.config.SnapshotCipherConfigurationTest",
    deps = MODULE_DEPS + TEST_DEPS,
)

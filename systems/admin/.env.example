# Database
# admin 은 ddl-auto: validate 이고 마이그레이션 도구가 없으므로
# admin-bootstrap/src/main/resources/schema.sql 을 DB 에 먼저 적용해야 한다.
DB_USERNAME=root
DB_PASSWORD=change-me
DB_URL=jdbc:mysql://localhost:3306/admin_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Admission
ADMISSION_YEAR=2027
FIRST_SCREENING_QUOTA=80
FINAL_SCREENING_QUOTA=72
GENERAL_QUOTA=20
MEISTER_QUOTA=10
SOCIAL_QUOTA=10

# Storage (자격 증명, 리전, 엔드포인트는 AWS 표준 환경변수를 따른다)
STORAGE_BUCKET=entrydsm-admin
DOWNLOAD_URL_EXPIRES_SECONDS=900
AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

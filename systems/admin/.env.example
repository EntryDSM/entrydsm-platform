# Server
# Gateway 의 GATEWAY_SERVICES_ADMIN 이 가리키는 포트와 반드시 같아야 한다.
# 다르면 Gateway 가 연결하지 못해 admin 경로 전체가 502 로 떨어진다.
SERVER_PORT=8083

# Database
DB_USERNAME=root
DB_PASSWORD=change-me
DB_URL=jdbc:mysql://localhost:3306/admin_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Admission
ADMISSION_YEAR=2027
# 1차(서류) 선발 인원 = 모집 정원 × 배수(올림)
FIRST_PASS_MULTIPLIER=1.5

# Storage (자격 증명, 리전, 엔드포인트는 AWS 표준 환경변수를 따른다)
# configuration 의 AWS_S3_BUCKET 과 반드시 같은 값이어야 한다. 원서 원본은
# configuration 이 올리고 admin 이 내려주므로, 다르면 원서 원본 다운로드가 계속 404 다.
AWS_S3_BUCKET=entrydsm-document-local
DOWNLOAD_URL_EXPIRES_SECONDS=900
AWS_REGION=ap-northeast-2
# 로컬 MinIO 를 쓸 때만 설정
# AWS_ENDPOINT_URL_S3=http://localhost:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Notification gRPC (공지사항 등록 위임 대상)
NOTIFICATION_GRPC_HOST=notification
NOTIFICATION_GRPC_PORT=9090
NOTIFICATION_GRPC_DEADLINE_MS=3000

# Application gRPC (원서 원본 조회와 전형 결과 반영 대상)
APPLICATION_GRPC_HOST=application
APPLICATION_GRPC_PORT=9090
APPLICATION_GRPC_DEADLINE_MS=5000

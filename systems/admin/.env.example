# Server
# Gateway 의 GATEWAY_SERVICES_ADMIN 이 가리키는 포트와 반드시 같아야 한다.
# 다르면 Gateway 가 연결하지 못해 admin 경로 전체가 502 로 떨어진다.
SERVER_PORT=8083
SWAGGER_ENABLED=true

# Database
DB_USERNAME=root
DB_PASSWORD=change-me
DB_URL=jdbc:mysql://localhost:3306/admin_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_MAX_POOL_SIZE=3
DB_MIN_IDLE=1

# Admission
# 1차(서류) 선발 인원 = 모집 정원 × 배수(올림)
FIRST_PASS_MULTIPLIER=1.5

# Application gRPC (지원자 원서 조회). application 의 GRPC_PORT 와 같아야 한다.
# 미설정 시 docker compose 기준 application:9090 으로 붙는다.
APPLICATION_GRPC_HOST=localhost
APPLICATION_GRPC_PORT=9090
APPLICATION_GRPC_DEADLINE_MS=3000
# 지원자 목록은 회차 전체를 한 번에 받아 온다.
APPLICATION_GRPC_LIST_DEADLINE_MS=10000

# Notification gRPC (공지 등록 위임). notification 의 GRPC_PORT 와 같아야 한다.
# 미설정 시 docker compose 기준 notification:9090 으로 붙는다.
NOTIFICATION_GRPC_HOST=localhost
NOTIFICATION_GRPC_PORT=9094

# Configuration gRPC (수험표 한 장을 document 가 그린다). configuration 의 GRPC_PORT 와 같아야 한다.
# 미설정 시 docker compose 기준 configuration:9090 으로 붙는다.
CONFIGURATION_GRPC_HOST=localhost
CONFIGURATION_GRPC_PORT=9090
CONFIGURATION_GRPC_DEADLINE_MS=10000

# Storage (자격 증명, 리전, 엔드포인트는 AWS 표준 환경변수를 따른다)
STORAGE_BUCKET=entrydsm-admin
DOWNLOAD_URL_EXPIRES_SECONDS=900
AWS_REGION=ap-northeast-2
# 로컬 MinIO 를 쓸 때만 설정
# AWS_ENDPOINT_URL_S3=http://localhost:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Kakao 지도/길찾기
KAKAO_REST_API_KEY=change-me
KAKAO_GEOCODING_URL=https://dapi.kakao.com/v2/local/search/keyword.json
KAKAO_DIRECTIONS_URL=https://apis-navi.kakaomobility.com/v1/directions
KAKAO_API_TIMEOUT_MS=3000
SCHOOL_ADDRESS=대덕소프트웨어마이스터고등학교

LOGGING_LEVEL_ROOT=INFO

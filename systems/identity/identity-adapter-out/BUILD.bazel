load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library", "kt_jvm_test")
load("//:kotlin.bzl", "jpa_allopen_plugins")
load(":deps.bzl", "MODULE_DEPS", "TEST_DEPS")

# 모듈 경계: 이 모듈 안에서만 의존할 수 있다. 다른 모듈은 <module>-api 타깃만 쓴다.
package(default_visibility = ["//systems/identity:__subpackages__"])

java_import(
    name = "okcert",
    jars = ["libs/OkCert3-java1.5-2.3.1.jar"],
)

kt_jvm_library(
    name = "main",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    javac_opts = "//:javac_options",
    kotlinc_opts = "//:kotlinc_options",
    plugins = jpa_allopen_plugins(target_name = "spring_allopen"),
    deps = MODULE_DEPS + [":okcert"],
)

kt_jvm_test(
    name = "test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    javac_opts = "//:javac_options",
    kotlinc_opts = "//:kotlinc_options",
    test_class = "hs.kr.entrydsm.identity.adapterout.IdentityAdapterOutModuleTest",
    deps = [":main"] + MODULE_DEPS + TEST_DEPS + [
        "//systems/identity/identity-test-support:main",
    ],
)

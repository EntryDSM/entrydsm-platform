# Spring profile: dev or prod
SPRING_PROFILES_ACTIVE=dev

# Database
DB_USERNAME=root
DB_PASSWORD=change-me
DB_URL=jdbc:mysql://localhost:3306/identity_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Redis
# Use rediss:// with TLS in production. Keep credentials in the URL or a secret manager.
REDIS_URL=redis://:change-me@localhost:6379
REDIS_KEY_NAMESPACE=dev.identity
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
REDIS_CLIENT_NAME=identity
REDIS_DURABILITY_CHECK_ENABLED=false
# Redis 운영은 AOF 등 durable persistence와 refresh version key를 축출하지 않는 정책을 사용해야 합니다.
# 운영 profile에서는 REDIS_DURABILITY_CHECK_ENABLED=true를 유지하세요.

# JWT
JWT_ISSUER=entrydsm-identity
JWT_SECRET=replace-with-a-secret-that-is-at-least-32-characters

# Auth safety
BCRYPT_STRENGTH=12
# Local HTTP development only; keep true in production.
COOKIE_SECURE=false
# PASS/OTP verification port 연결 전에는 password reset endpoint를 노출하지 않습니다.
AUTH_PASSWORD_RESET_ENABLED=false
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=5
AUTH_PASSWORD_RESET_WINDOW_SECONDS=900
AUTH_PASSWORD_RESET_MAX_TRACKED_LOGIN_IDS=10000

# Identity security
IDENTITY_CORS_ALLOWED_ORIGINS=http://localhost:3000
IDENTITY_LOGIN_ID_HASH_KEY=dev-login-id-hash-key
IDENTITY_PII_ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# PASS verification
PASS_TARGET=TEST
PASS_CP_CODE=
PASS_LICENSE=
PASS_LICENSE_FILE_URL=
PASS_LICENSE_FILE_PATH=/tmp/V61290000000_IDS_01_PROD_AES_license.dat
BASE_URL=http://localhost:3000
SITE_NAME=EntryDSM
SITE_URL=http://localhost:3000
PASS_POPUP_URL=http://localhost:3000/mock/pass
PASS_PROOF_TTL_SECONDS=300
PASS_CONNECT_TIMEOUT_MS=5000
PASS_READ_TIMEOUT_MS=10000
PASS_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000
PASS_PROOF_KEY_CURRENT=dev-proof-key
PASS_PROOF_KEY_PREVIOUS=

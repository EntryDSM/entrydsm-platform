# entrydsm-platform 실행 환경변수 (모든 모듈 공용)
# 복사해서 systems/platform/.env 로 쓰고 `./run-service.sh platform` 으로 실행한다.

# Spring profile: dev 이면 아래 대부분에 로컬 기본값이 적용된다.
SPRING_PROFILES_ACTIVE=dev

# ── Server ───────────────────────────────────────────────
SERVER_PORT=8080

# ── Database (스키마 1개, 모듈별 Flyway 이력 테이블) ──────────
DB_URL=jdbc:mysql://localhost:3306/entrydsm?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

# ── Redis (identity 토큰·PASS 증명, observability 지표·로그가 같이 쓴다) ──
# 운영에서는 rediss:// 와 인증 정보를 쓴다.
REDIS_URL=redis://:change-me@localhost:6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
REDIS_CLIENT_NAME=entrydsm-platform

# ── S3 (admin 내보내기·수험표, configuration 문서가 같이 쓴다) ──
# 자격 증명과 엔드포인트는 AWS 표준 환경변수를 따른다. 로컬 MinIO 를 쓸 때만 AWS_ENDPOINT_URL_S3 를 준다.
AWS_S3_REGION=ap-northeast-2
# AWS_ENDPOINT_URL_S3=http://localhost:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── identity 모듈 ────────────────────────────────────────
# 프로세스 바깥 경계(구 gateway). 여러 origin 은 쉼표로 구분한다.
EDGE_CORS_ALLOWED_ORIGINS=http://localhost:3000
EDGE_REQUEST_MAX_BODY_BYTES=10485760
IDENTITY_REDIS_KEY_NAMESPACE=dev.identity
# 운영에서는 true 로 두고, Redis 는 AOF 등 durable persistence 와 refresh version 키를 축출하지 않는 정책을 쓴다.
IDENTITY_REDIS_DURABILITY_CHECK_ENABLED=false
JWT_ISSUER=entrydsm-identity
JWT_SECRET=replace-with-a-secret-that-is-at-least-32-characters
BCRYPT_STRENGTH=12
# 로컬 HTTP 개발에서만 false. 운영에서는 true.
COOKIE_SECURE=false
# PASS/OTP 검증 포트를 연결하기 전에는 비밀번호 재설정 엔드포인트를 열지 않는다.
AUTH_PASSWORD_RESET_ENABLED=false
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=5
AUTH_PASSWORD_RESET_WINDOW_SECONDS=900
AUTH_PASSWORD_RESET_MAX_TRACKED_LOGIN_IDS=10000
IDENTITY_LOGIN_ID_HASH_KEY=dev-login-id-hash-key
IDENTITY_PII_ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PASS_TARGET=TEST
PASS_CP_CODE=
PASS_LICENSE=
PASS_LICENSE_FILE_URL=
PASS_LICENSE_FILE_PATH=/tmp/V61290000000_IDS_01_PROD_AES_license.dat
BASE_URL=http://localhost:3000
SITE_NAME=EntryDSM
SITE_URL=http://localhost:3000
PASS_POPUP_URL=http://localhost:3000/mock/pass
PASS_PROOF_TTL_SECONDS=300
PASS_CONNECT_TIMEOUT_MS=5000
PASS_READ_TIMEOUT_MS=10000
PASS_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000
PASS_PROOF_KEY_CURRENT=dev-proof-key
PASS_PROOF_KEY_PREVIOUS=

# ── application 모듈 ─────────────────────────────────────
# 형식: yyyy-MM-ddTHH:mm:ss
APPLICATION_START_AT=2026-09-01T00:00:00
APPLICATION_END_AT=2026-10-01T00:00:00
RESULT_ANNOUNCED_AT=2026-11-01T00:00:00

# ── configuration 모듈 ───────────────────────────────────
AWS_S3_BUCKET=entrydsm-document-local
AWS_S3_PRESIGN_EXPIRY_SECONDS=600

# ── admin 모듈 ───────────────────────────────────────────
ADMISSION_YEAR=2027
# 1차(서류) 선발 인원 = 모집 정원 × 배수(올림)
FIRST_PASS_MULTIPLIER=1.5
ADMIN_STORAGE_BUCKET=entrydsm-admin
ADMIN_DOWNLOAD_URL_EXPIRES_SECONDS=900

# ── observability 모듈 ───────────────────────────────────
# 대시보드와 리포트에 표시할 모집 회차
MONITOR_ROUND_NAME=2027
MONITOR_ROUND_FROM=2026-09-01T00:00:00+09:00
MONITOR_ROUND_TO=2026-11-01T00:00:00+09:00

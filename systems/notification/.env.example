# Spring profile: dev or prod
SPRING_PROFILES_ACTIVE=dev

# Server
SERVER_PORT=8080

# Database
DB_USERNAME=root
DB_PASSWORD=change-me
DB_URL=jdbc:mysql://localhost:3306/notification_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# gRPC (admin 의 NOTIFICATION_GRPC_PORT 와 같아야 한다)
# 미설정 시 9090. 로컬에서는 application(9090)과 겹치지 않게 따로 준다.
GRPC_PORT=9094
